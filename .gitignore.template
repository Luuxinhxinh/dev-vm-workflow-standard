# PNet / EVE-NG Git Ignore Template
# Tránh commit các file nặng làm nghẽn Git và lệch nhịp môi trường

# Images giả lập (Dung lượng hàng chục GB - chia sẻ qua Drive/NAS riêng)
/opt/unetlab/addons/qemu/*
/opt/unetlab/addons/iol/bin/*
/opt/unetlab/addons/dynamips/*
!/opt/unetlab/addons/**/.gitkeep

# Temporary & runtime data
/opt/unetlab/tmp/*
/tmp/*
*.log
*.pid
/run/pnetlab/*

# User Labs cá nhân thử nghiệm
/opt/unetlab/labs/test_*
/opt/unetlab/labs/tmp_*

# OS & Editor generated files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Environment specific configurations
.env
config.local.php
